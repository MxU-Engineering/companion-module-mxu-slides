	"version": "0.0.0",
	"license": "MIT",
	"repository": "git+https://github.com/bitfocus/companion-module-mxu-slides.git",
	"bugs": "https://github.com/bitfocus/companion-module-mxu-slides/issues",
	"maintainers": [
		{
			"name": "MxU",
			"email": "support@getmxu.com"
		}
	],
	"runtime": {
		"type": "node26",
